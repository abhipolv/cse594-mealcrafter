# Copy to .env.local for local development. Never commit real values.

# Postgres. Local default matches scripts/db-up.mjs. In production this is the
# Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgres://mealcrafter:mealcrafter@localhost:54329/mealcrafter

# Signs the login cookie. Any long random string; generate with `openssl rand -base64 32`.
SESSION_SECRET=dev-only-change-me-dev-only-change-me

# "mock" uses recorded responses (free, deterministic, no key needed).
# "live" calls the Anthropic API and needs ANTHROPIC_API_KEY.
AI_MODE=mock
ANTHROPIC_API_KEY=
RECOGNIZER_MODEL=claude-opus-5-5
SUGGESTER_MODEL=claude-sonnet-5-5

# Photo storage. Leave empty locally to store uploads under .data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# Local folder of test fridge media (the team Dropbox folder "MealCrafter Test Media").
# Used by scripts/eval only; the app never reads it.
MEDIA_DIR=
